{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qwik-books-optimized",
  "main": "./dist/_worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSET",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
