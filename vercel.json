{
  "headers": [
    {
      "source": "/(.*)?service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(assets|build)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable"
        }
      ]
    }
  ],
  "ignoreCommand": "case \"$VERCEL_PROJECT_PRODUCTION_URL\" in \"\") false;; *-optimized*) [ \"$VERCEL_GIT_COMMIT_REF\" != optimized ];; *) [ \"$VERCEL_GIT_COMMIT_REF\" != main ];; esac",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "optimized": true
    }
  }
}
